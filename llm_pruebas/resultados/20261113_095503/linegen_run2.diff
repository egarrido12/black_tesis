+def _leaf_prefix_lengths(line: Line) -> dict[LeafID, int]:
+    """Map each leaf's id to the width of everything that precedes it on `line`."""
+    prefix_lengths: dict[LeafID, int] = {}
+    current_length = 4 * line.depth
+    for leaf in line.leaves:
+        prefix_lengths[id(leaf)] = current_length
+        current_length += len(leaf.prefix) + len(leaf.value)
+    return prefix_lengths
