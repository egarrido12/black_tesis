+def _is_fmt_off_on_block(value: str) -> bool:
+    """Is `value` a comment-only block starting with `fmt: off` and ending with
+    `fmt: on`, each directive on its own line?"""
+    lines = value.splitlines()
+    return (
+        len(lines) >= 2
+        and contains_fmt_directive(lines[0], FMT_OFF)
+        and contains_fmt_directive(lines[-1], FMT_ON)
+    )
+
+
+def _prefix_has_regular_comment(prefix: str) -> bool:
+    """Does `prefix` contain a comment line that isn't a `# fmt:` directive?"""
+    return any(
+        line.strip().startswith("#") and not contains_fmt_directive(line.strip())
+        for line in prefix.split("\n")
+    )
+
