+def _target_version_suffix(target_versions: Collection[TargetVersion]) -> str:
+    """Return the " for target version X" text used in parse error messages."""
+    if not target_versions:
+        return ""
+    max_tv = max(target_versions, key=lambda tv: tv.value)
+    return f" for target version {max_tv.pretty()}"
+
+
+def _make_invalid_input(
+    src_txt: str,
+    lineno: int,
+    column: int,
+    tv_str: str,
+    error_description: str,
+) -> InvalidInput:
+    """Build an `InvalidInput` pointing at the offending line of `src_txt`."""
+    lines = src_txt.splitlines()
+    try:
+        faulty_line = lines[lineno - 1]
+    except IndexError:
+        faulty_line = "<line number missing in source>"
+    context = f"cannot parse{tv_str}"
+    details = "\n".join((
+        "",
+        f"    {faulty_line}",
+        f"    {' ' * (column - 1)}^",
+        error_description,
+    ))
+    error_msg = f"{context}: {lineno}:{column}{details}"
+    return InvalidInput(error_msg, lineno, column, context, details)
+
+
