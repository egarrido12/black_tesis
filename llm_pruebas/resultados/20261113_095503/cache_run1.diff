+        try:
+            data: dict[str, tuple[float, int, str]] = pickle.load(fobj)
+            return {path: FileData(*values) for path, values in data.items()}
+        except (
+            pickle.UnpicklingError,
+            EOFError,
+            ValueError,
+            IndexError,
+            PermissionError,
+        ):
+            return {}
 
 
