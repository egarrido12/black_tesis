+def _report_verbose_configuration(
+    ctx: click.Context, *, root: Path | None, method: str | None, config: str | None
+) -> None:
+    if root:
+        out(
+            f"Identified `{root}` as project root containing a {method}.",
+            fg="blue",
+        )
+
+    if not config:
+        return
+
+    config_source = ctx.get_parameter_source("config")
+    user_level_config = str(find_user_pyproject_toml())
+    if config == user_level_config:
+        out(
+            "Using configuration from user-level config at "
+            f"'{user_level_config}'.",
+            fg="blue",
+        )
+    elif config_source in (
+        ParameterSource.DEFAULT,
+        ParameterSource.DEFAULT_MAP,
+    ):
+        out("Using configuration from project root.", fg="blue")
+    else:
+        out(f"Using configuration in '{config}'.", fg="blue")
+    if ctx.default_map:
+        for param, value in ctx.default_map.items():
+            out(f"{param}: {value}")
+
+
+def _is_required_version_mismatch(required_version: str | None) -> bool:
+    """Is a `--required-version` given that matches neither full nor major version?"""
+    return bool(
+        required_version
+        and required_version != __version__
+        and required_version != __version__.split(".")[0]
+    )
+
