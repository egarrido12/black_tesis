+    force_exclude: Pattern[str] | None,
+) -> str | None:
+    """Return the report message for the first exclusion regex matching the path.
+
+    The regexes are checked in order: `--exclude`, `--extend-exclude` and
+    `--force-exclude`. Returns None if none of them matches.
+    """
+    checks = (
