+        (extend_exclude, "--extend-exclude"),
+        (force_exclude, "--force-exclude"),
+    )
+    for pattern, option in checks:
+        if path_is_excluded(root_relative_path, pattern):
+            return f"matches the {option} regular expression"
+    return None
+
