+            docstring,
+            quote_len=quote_len,
+            indent=indent,
+            line_length=self.mode.line_length,
+            has_trailing_backslash=has_trailing_backslash,
+        ):
+            # If the closing quote is not already prefixed by a newline, put a
+            # line break before it.
+            if leaf.value[-1 - quote_len] == "\n":
+                leaf.value = prefix + quote + docstring + quote
+            else:
+                leaf.value = prefix + quote + docstring + "\n" + indent + quote
+        else:
+            leaf.value = prefix + quote + docstring + quote
 
