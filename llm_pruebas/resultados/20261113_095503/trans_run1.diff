+    def _is_strippable_parenthesized_string(self, line: Line, string_idx: int) -> bool:
+        """Is `line.leaves[string_idx]` a string whose parentheses can be stripped?
+
+        See the 'Requirements' section of this class's docstring.
+        """
+        LL = line.leaves
+
+        is_valid_index = is_valid_index_factory(LL)
+
+        leaf = LL[string_idx]
+
+        # Should be a string...
+        if leaf.type != token.STRING:
+            return False
+
+        # If this is a "pointless" string...
+        if (
+            leaf.parent
+            and leaf.parent.parent
+            and leaf.parent.parent.type == syms.simple_stmt
+        ):
+            return False
+
+        # Should be preceded by a non-empty LPAR...
+        if (
+            not is_valid_index(string_idx - 1)
+            or LL[string_idx - 1].type != token.LPAR
+            or is_empty_lpar(LL[string_idx - 1])
+        ):
+            return False
+
+        # That LPAR should NOT be preceded by a colon (which could be a
+        # dictionary value), function name, or a closing bracket (which
+        # could be a function returning a function or a list/dictionary
+        # containing a function)...
+        if is_valid_index(string_idx - 2) and (
+            LL[string_idx - 2].type == token.COLON
+            or LL[string_idx - 2].type == token.NAME
+            or LL[string_idx - 2].type in CLOSING_BRACKETS
+        ):
+            return False
+
+        # Skip the string trailer, if one exists.
+        next_idx = StringParser().parse(LL, string_idx)
+
+        # if the leaves in the parsed string include a PERCENT, we need to
+        # make sure the initial LPAR is NOT preceded by an operator with
+        # higher or equal precedence to PERCENT
+        if (
+            is_valid_index(string_idx - 2)
+            and token.PERCENT in {l.type for l in LL[string_idx - 1 : next_idx]}
+            and _binds_tighter_than_percent(LL[string_idx - 2])
+        ):
+            return False
+
+        # Should be followed by a non-empty RPAR...
+        if not (
+            is_valid_index(next_idx)
+            and LL[next_idx].type == token.RPAR
+            and not is_empty_rpar(LL[next_idx])
+        ):
+            return False
+
+        # That RPAR should NOT be followed by anything with higher
+        # precedence than PERCENT
+        if (
+            is_valid_index(next_idx + 1)
+            and LL[next_idx + 1].type in _TOKENS_BINDING_TIGHTER_THAN_PERCENT_AFTER_RPAR
+        ):
+            return False
+
+        # Keep the parens if stripping them would leave an already
+        # too-long line with a merged string group glued to an `=`
+        # prefix (e.g. a def parameter default). Black cannot split
+        # such a line after the fact, while the parens let the layout
+        # split the group at its custom breakpoints. See #3497.
+        if (
+            not is_line_short_enough(line, mode=line.mode)
+            and is_valid_index(string_idx - 2)
+            and LL[string_idx - 2].type == token.EQUAL
+            and self.has_custom_splits(LL[string_idx].value)
+        ):
+            return False
+
+        return True
 
