+def _end_of_string_run(leaves: Sequence[Leaf], start: int) -> int:
+    """Return the index of the first non-STRING leaf at or after `start`.
+
+    If every leaf from `start` on is a STRING, `len(leaves)` is returned.
+    """
+    idx = start
+    while idx < len(leaves) and leaves[idx].type == token.STRING:
+        idx += 1
+    return idx
+
+
+def _last_string_index_in_run(leaves: Sequence[Leaf], start: int) -> int:
+    """Return the index of the last STRING of the run of strings starting at `start`.
+
+    Pre-conditions:
+        * @leaves[@start].type == token.STRING
+    """
+    return _end_of_string_run(leaves, start) - 1
+
+
+def _string_idx_after_first_leaf(leaves: list[Leaf]) -> int | None:
+    """Return the index of the string that follows the first leaf, if any.
