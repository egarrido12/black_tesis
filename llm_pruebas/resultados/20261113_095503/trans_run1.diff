+def _binds_tighter_than_percent(leaf: Leaf) -> bool:
+    """Is `leaf` an operator that binds at least as tightly as a `%` after it?"""
+    if leaf.type in _TOKENS_BINDING_TIGHTER_THAN_PERCENT_BEFORE_LPAR:
+        return True
