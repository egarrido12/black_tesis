+def _exclusion_message(
+    root_relative_path: str,
+    exclude: Pattern[str],
+    extend_exclude: Pattern[str] | None,
+    force_exclude: Pattern[str] | None,
+) -> str | None:
+    """Return why the path is excluded by a regex option, or None if it is not.
+
+    The options are checked in the order `--exclude`, `--extend-exclude`,
+    `--force-exclude`; the first match wins.
+    """
+    checks: tuple[tuple[Pattern[str] | None, str], ...] = (
+        (exclude, "--exclude"),
+        (extend_exclude, "--extend-exclude"),
+        (force_exclude, "--force-exclude"),
+    )
+    for pattern, option in checks:
+        if path_is_excluded(root_relative_path, pattern):
+            return f"matches the {option} regular expression"
+    return None
+
