+    @staticmethod
+    def _is_preceded_by_strippable_lpar(LL: list[Leaf], idx: int) -> bool:
+        """
+        Returns:
+            True iff the string at @LL[idx] is preceded by a non-empty LPAR that
+            is not preceded by a colon (which could be a dictionary value), a
+            function name, or a closing bracket (which could be a function
+            returning a function or a list/dictionary containing a function).
+        """
+        is_valid_index = is_valid_index_factory(LL)
+
+        # Should be preceded by a non-empty LPAR...
+        if (
+            not is_valid_index(idx - 1)
+            or LL[idx - 1].type != token.LPAR
+            or is_empty_lpar(LL[idx - 1])
+        ):
+            return False
+
+        # That LPAR should NOT be preceded by a colon (which could be a
+        # dictionary value), function name, or a closing bracket (which
+        # could be a function returning a function or a list/dictionary
+        # containing a function)...
+        if is_valid_index(idx - 2) and (
+            LL[idx - 2].type == token.COLON
+            or LL[idx - 2].type == token.NAME
+            or LL[idx - 2].type in CLOSING_BRACKETS
+        ):
+            return False
+
+        return True
+
+    @staticmethod
+    def _percent_conflicts_with_preceding_operator(
+        LL: list[Leaf], idx: int, next_idx: int
+    ) -> bool:
+        """
+        Returns:
+            True iff the parenthesized string trailer (LL[idx - 1 : next_idx])
+            contains a PERCENT and the initial LPAR is preceded by an operator
+            with higher or equal precedence than PERCENT.
+        """
+        if not is_valid_index_factory(LL)(idx - 2):
+            return False
+
+        before_lpar = LL[idx - 2]
+        if token.PERCENT not in {leaf.type for leaf in LL[idx - 1 : next_idx]}:
+            return False
+
+        return before_lpar.type in _OPERATORS_BEFORE_LPAR_BINDING_AT_LEAST_AS_PERCENT or bool(
+            # only unary PLUS/MINUS
+            before_lpar.parent
+            and before_lpar.parent.type == syms.factor
+            and (before_lpar.type in {token.PLUS, token.MINUS})
+        )
+
+    def _would_strand_long_line(self, line: Line, string_idx: int) -> bool:
+        """
+        Returns:
+            True iff stripping the parens would leave an already too-long line
+            with a merged string group glued to an `=` prefix (e.g. a def
+            parameter default). Black cannot split such a line after the fact,
+            while the parens let the layout split the group at its custom
+            breakpoints. See #3497.
+        """
+        LL = line.leaves
+        return (
+            not is_line_short_enough(line, mode=line.mode)
+            and is_valid_index_factory(LL)(string_idx - 2)
+            and LL[string_idx - 2].type == token.EQUAL
+            and self.has_custom_splits(LL[string_idx].value)
+        )
