+def _parse_line_range(lines_str: str) -> tuple[int, int]:
+    """Parse and validate a single `START-END` range."""
+    parts = lines_str.split("-")
+    if len(parts) != 2:
+        raise ValueError(
+            "Incorrect --line-ranges format, expect 'START-END', found"
+            f" {lines_str!r}"
+        )
+    try:
+        start = int(parts[0])
