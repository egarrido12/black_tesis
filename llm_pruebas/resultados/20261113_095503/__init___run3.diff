+def _require_string_option(config: dict[str, Any], key: str) -> None:
+    """Raise a usage error if the config value for `key` is set but not a string."""
+    value = config.get(key)
+    if value is not None and not isinstance(value, str):
+        option_name = key.replace("_", "-")
+        raise click.BadOptionUsage(
+            option_name, f"Config key {option_name} must be a string"
+        )
+
