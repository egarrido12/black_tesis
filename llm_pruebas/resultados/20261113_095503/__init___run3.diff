+def _validate_pyproject_option_types(config: dict[str, Any]) -> None:
+    """Validate the types of the options that Click needs to receive in a given form."""
+    target_version = config.get("target_version")
+    if target_version is not None and not isinstance(target_version, list):
+        raise click.BadOptionUsage(
+            "target-version", "Config key target-version must be a list"
+        )
+
+    for key in ("exclude", "include", "extend_exclude", "force_exclude"):
+        _require_string_option(config, key)
+
+    if config.get("line_ranges") is not None:
+        raise click.BadOptionUsage(
+            "line-ranges", "Cannot use line-ranges in the pyproject.toml file."
