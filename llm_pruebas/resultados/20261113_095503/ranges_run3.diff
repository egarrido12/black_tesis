+def _map_line_to_modified(
+    line: int, mapping: "_LinesMapping", *, is_range_start: bool
+) -> int:
+    """Map an original line number (one end of a range) to the modified source."""
+    if mapping.is_changed_block:
+        # When the line falls into a changed block, expands to the whole block.
+        return mapping.modified_start if is_range_start else mapping.modified_end
+    return line - mapping.original_start + mapping.modified_start
 
 
