+def _convert_match_subject(
+    newline: Leaf,
+    match_stmt: Node,
+    replacements: _NodeReplacements,
+    lines_set: frozenset[int],
+) -> None:
+    """Convert the `match <subject>:` line when it is entirely unchanged.
+
+    The `suite` node is defined as:
+      match_stmt: "match" subject_expr ':' NEWLINE INDENT case_block+ DEDENT
+    Here we need to check `subject_expr`. The `case_block+` will be checked by
+    their own NEWLINEs.
+    """
+    nodes_to_ignore: list[LN] = []
+    prev_sibling = newline.prev_sibling
+    while prev_sibling:
+        nodes_to_ignore.append(prev_sibling)
+        prev_sibling = prev_sibling.prev_sibling
+    nodes_to_ignore.reverse()
+    if not _get_line_range(nodes_to_ignore).intersection(lines_set):
+        _convert_nodes_to_standalone_comment(
+            nodes_to_ignore,
+            newline=newline,
+            replacements=replacements,
+            lines_set=lines_set,
+        )
+
+
+def _convert_clause_header(
+    newline: Leaf,
+    parent: Node,
+    replacements: _NodeReplacements,
+    lines_set: frozenset[int],
+) -> None:
+    """Convert a compound statement's clause line (or a body on its clause line).
+
+    The `suite` node is defined as:
+      suite: simple_stmt | NEWLINE INDENT stmt+ DEDENT
+    We will check `simple_stmt` and `stmt+` separately against the lines set.
+    """
+    parent_sibling = parent.prev_sibling
+    nodes_to_ignore: list[LN] = []
+    while parent_sibling and parent_sibling.type not in {
+        syms.suite,
+        syms.simple_stmt,
+    }:
+        # NOTE: Multiple suite nodes can exist as siblings in e.g. `if_stmt`.
+        nodes_to_ignore.insert(0, parent_sibling)
+        parent_sibling = parent_sibling.prev_sibling
+    if parent.type == syms.simple_stmt:
+        # A body on its clause's line is checked with the clause.
+        nodes_to_ignore.extend(parent.children[:-1])
+    # Special case for `async_stmt` and `async_funcdef` where the ASYNC
+    # token is on the grandparent node.
+    grandparent = parent.parent
+    if (
+        parent_sibling is None
+        and grandparent is not None
+        and grandparent.prev_sibling is not None
+        and grandparent.prev_sibling.type == ASYNC
+    ):
+        nodes_to_ignore.insert(0, grandparent.prev_sibling)
+    if not _get_line_range(nodes_to_ignore).intersection(lines_set):
+        _convert_nodes_to_standalone_comment(
+            nodes_to_ignore,
+            newline=newline,
+            replacements=replacements,
+            lines_set=lines_set,
+        )
+
